rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Was the Step 1 connectivity check (now retired). Left open since no
    // real data lives here — tighten this if/when it bothers you.
    match /diagnostics/{docId} {
      allow read, write: if true;
    }

    // Step 2: any of the three family members can read the user list
    // (needed later for reminder-recipient pickers, Settings → People).
    // Self-provisioning on first sign-in always starts as "member" — you
    // cannot create or edit your own doc into "admin"; only an existing
    // admin can promote someone (Settings → People, built in Step 14).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'member';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
        || isAdmin()
      );
    }

    // Step 4: /config/taxonomy, plus the rest of /config that lands in
    // later steps (storageLocations, yearColorMap in Step 5; targets in
    // Step 11) — same access shape for all of them, so no rules churn
    // needed when those land. Every signed-in family member can read
    // (needed for the check-in/out flow), only admin can write.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Step 6: /products (master catalog). Unlike /config, any signed-in
    // family member can create a new product — SPEC.md Section 5 has
    // members adding one inline during check-in the first time something
    // new is bought (Step 7) — there's no standalone admin catalog screen
    // any more. Editing/deleting an existing entry stays admin-only
    // (reachable via a future admin stock table / targets flow).
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Step 7: /stockItems (one doc per purchase batch). Check-in/check-out
    // is a member action, not admin-only (SPEC.md Section 3), so all CRUD
    // is open to any signed-in family member — including delete, needed
    // both for the check-in undo toast and for a check-out that empties a
    // batch. The admin stock table's bulk-delete (Step 9) is a UI
    // convenience on top of this, not a separate permission tier.
    match /stockItems/{itemId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Everything else stays locked down until its own build step wires up
    // real rules (checklists in Step 12, etc.).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
