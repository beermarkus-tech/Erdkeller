rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Step 1 connectivity check only (js/firebase-test.js). Harmless to
    // leave open — no real data lives here.
    match /diagnostics/{docId} {
      allow read, write: if true;
    }

    // Step 2: any of the three family members can read the user list
    // (needed later for reminder-recipient pickers, Settings → People).
    // Self-provisioning on first sign-in always starts as "member" — you
    // cannot create or edit your own doc into "admin"; only an existing
    // admin can promote someone (Settings → People, built in Step 14).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'member';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
        || isAdmin()
      );
    }

    // Everything else stays locked down until its own build step wires up
    // real rules (taxonomy/config in Step 4-5, stock in Step 7+, etc.).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
