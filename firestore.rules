rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasAuth() {
      return request.auth != null;
    }

    // "Signed in" means more than a valid Firebase session — it means an
    // ACTIVE, non-removed household member (Build 180). This gates nearly
    // every rule below, so tightening it here closes two things at once:
    // (1) it used to mean nothing more than "authenticated with any Google
    // account" — there was no real gate stopping any Google account from
    // self-provisioning as a member and reading the whole household's
    // data; (2) it's what makes Settings → Personen's "Entfernen" action
    // an actual, immediately server-enforced revocation rather than a
    // cosmetic removal from a list — see the tombstone comment on
    // /users/{userId} below for why a removed doc is kept, not deleted.
    function isSignedIn() {
      return hasAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.removed != true;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Was the Step 1 connectivity check (now retired). Left open since no
    // real data lives here — tighten this if/when it bothers you.
    match /diagnostics/{docId} {
      allow read, write: if true;
    }

    // Step 2: any active member can read the full roster (needed for
    // reminder-recipient pickers, Settings → People). Reading your OWN
    // doc is allowed unconditionally (hasAuth() only, not the tightened
    // isSignedIn() above) for two cases that both matter before a "real"
    // isSignedIn() could ever be true for you: a brand-new member's very
    // first read (js/auth.js's ensureUserDoc) is of their own NOT-YET-
    // EXISTING doc, and a REMOVED member must still be able to read their
    // own doc to see removed:true and get a clean, explained sign-out
    // (js/auth.js's profile listener) instead of permission-denied errors
    // scattered across every screen.
    //
    // Self-provisioning on first sign-in always starts as "member" — you
    // cannot create or edit your own doc into "admin"; only an existing
    // admin can promote someone (Settings → People, built in Step 14).
    // Removal (Build 180, Settings → Personen) sets removed:true rather
    // than deleting the doc — deleting it would let this same create rule
    // silently let a removed person re-join as a fresh member the next
    // time they open the app.
    match /users/{userId} {
      allow read: if (hasAuth() && request.auth.uid == userId) || isSignedIn();
      allow create: if hasAuth() && request.auth.uid == userId
        && request.resource.data.role == 'member';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
        || isAdmin()
      );
    }

    // Step 4: /config/taxonomy, plus the rest of /config that lands in
    // later steps (storageLocations, yearColorMap in Step 5; targets in
    // Step 11) — same access shape for all of them, so no rules churn
    // needed when those land. Every signed-in family member can read
    // (needed for the check-in/out flow), only admin can write.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Step 12 (legacy — superseded by /checklists + /checklistItems below,
    // see dev plan Step 16.3): /config/checklists is the one /config doc
    // any signed-in family member can write, not just admin — ticking off
    // a task is a member action, same reasoning as /stockItems check-in/
    // check-out (Step 7), not a structural edit. Firestore rules couldn't
    // cheaply tell "toggled one item's lastCompletedAt" apart from
    // "restructured the whole list" within one nested-array document, so
    // the document-level permission had to be member-wide, with the
    // admin-only Settings → Checklisten editor as the only thing actually
    // keeping add/remove/rename behind admin — enforced by UI convention,
    // not by these rules. This literal path match takes precedence over
    // the generic /config/{docId} wildcard above regardless of file order
    // — Firestore rules resolve to the most specific matching pattern for
    // a path.
    //
    // Kept live (not `if false`) until the Step 16.3 migration's cutover
    // ships and Cloud Functions' fallback read is retired — see the two
    // new match blocks below, which supersede this one for anything that
    // has migrated. Once cutover ships this becomes `allow write: if
    // false` first (a stale long-lived tab should fail loudly, not write
    // to a document nothing reads any more), then the whole block is
    // deleted.
    match /config/checklists {
      allow read, write: if isSignedIn();
    }

    // Step 16.3: the per-document replacement for /config/checklists
    // above, splitting one wholesale-rewritten document into two flat
    // collections so two devices editing offline can merge instead of
    // clobber (dev plan Step 16.3 has the full migration). Unlike the
    // legacy doc, rules here CAN cheaply tell a tick apart from a
    // restructure — each item is now its own document — so this is a
    // real enforcement, not just a UI convention: a member can only ever
    // change an item's lastCompletedAt/updatedAt: anything else (its
    // text, frequency, listId, or any /checklists list itself) requires
    // isAdmin(), for the first time actually server-enforced rather than
    // merely hidden behind the admin-only pencil toggle in the UI.
    match /checklists/{listId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /checklistItems/{itemId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastCompletedAt', 'updatedAt']));
    }

    // Step 6: /products (master catalog). Unlike /config, any signed-in
    // family member can create a new product — SPEC.md Section 5 has
    // members adding one inline during check-in the first time something
    // new is bought (Step 7) — there's no standalone admin catalog screen
    // any more. Editing/deleting an existing entry stays admin-only
    // (reachable via a future admin stock table / targets flow).
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Step 7: /stockItems (one doc per purchase batch). Check-in/check-out
    // is a member action, not admin-only (SPEC.md Section 3), so all CRUD
    // is open to any signed-in family member — including delete, needed
    // both for the check-in undo toast and for a check-out that empties a
    // batch. The admin stock table's bulk-delete (Step 9) is a UI
    // convenience on top of this, not a separate permission tier.
    match /stockItems/{itemId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Step 8: /stockLog — a running feed of check-in/check-out actions,
    // shown on the success screen after each guided-flow action. Entries
    // are append-only from the app's perspective (no update rule) except
    // for the undo toast, which deletes the just-created entry within its
    // few-second window — same permission shape as /stockItems.
    match /stockLog/{logId} {
      allow read, create, delete: if isSignedIn();
    }

    // Step 13: /contacts — SPEC.md Section 9 has adding/editing contacts as
    // admin-only ("same model as checklists" for permissions, unlike
    // /config/checklists' member-writable content); any signed-in family
    // member can read. /notes and /recipes get the identical shape.
    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Step 13: /notes — same shape as /contacts above (Section 9: "Adding/
    // editing contacts and notes is admin-only"). Photos live inline on the
    // document as compressed base64 data URIs (no Firebase Storage on the
    // Spark plan), which is why a note document can be noticeably larger
    // than a contact — still just a plain document write, no different
    // rule needed.
    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Step 13 (Rezepte): identical shape to /notes above, per the comment
    // there — freeform tags/ingredients/body, same admin-only write /
    // member read split, same base64-photo-on-the-document approach.
    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Step 17 (push notifications): one device (FCM registration token) per
    // subcollection doc, not a single field on /users/{uid} — Markus alone
    // has a phone AND a tablet, so a single field would mean one device
    // silently displaces the other. A subcollection isn't covered by the
    // parent /users/{userId} match above (Firestore rules don't cascade to
    // subcollections), so it needs its own block or it falls through to the
    // deny-all catch-all below. Each user manages only their own devices;
    // admins can read (not write) everyone's, for a future "who's actually
    // registered" view in Settings.
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Step 17: send-tracking + per-period dismissal state for the reminder
    // scheduler. Deliberately its own doc rather than a key inside
    // /config/checklists or /config/notifications — both of those are
    // saved wholesale (setDoc from an in-memory object) by their own
    // screens, so any field a Cloud Function wrote into either would be
    // silently clobbered on the next unrelated save there. Member-writable
    // (not admin-only, unlike the generic /config/{docId} rule below) since
    // "Für diesen Zeitraum erledigt" is a member action, same permission
    // tier as ticking a checklist item itself (/config/checklists above).
    match /config/notificationState {
      allow read, write: if isSignedIn();
    }

    // Everything else stays locked down until its own build step wires up
    // real rules (checklists in Step 12, etc.).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
